PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NOTE: there is deliberately no JWT_SECRET here. This service does not verify
# Supabase access tokens itself — src/middleware/auth.ts hands the bearer token
# to supabase.auth.getUser(), and Supabase does the verification. Nothing reads
# a local JWT secret, so publishing one only invites someone to wire up a second,
# weaker verification path. The application draft token below is separate and
# is NOT a JWT; see src/lib/draftToken.ts.

# Signing secret for public application draft tokens (src/lib/draftToken.ts).
#
# REQUIRED. The application funnel (/api/applications/*) is unauthenticated by
# design — a stranger with no account applies there — so the signed token minted
# by POST /api/applications is the ONLY thing proving that whoever is calling
# /api/applications/:orgId/* actually started that application. Anyone who can
# guess or derive this secret can forge a token for any org id and read that
# firm's beneficial owners, member emails and documents.
#
# Must be at least 32 characters; the server refuses to sign or verify otherwise.
# Generate a fresh one per environment — never reuse the dev value in production,
# and never commit a real value to this file:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Rotating it invalidates every draft token in flight: applicants mid-application
# will get 401 draft_token_invalid and have to start over. Rotate deliberately.
APPLICATION_TOKEN_SECRET=generate-me-see-comment-above

# CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000,https://stauntontrade.com

# Proxy trust. Leave UNSET unless something in front of this server actually
# overwrites X-Forwarded-For. Rate limiting and the submitted-application
# attestation both key off req.ip; trusting the header when there is no proxy
# lets any caller spoof their IP, rotate their rate-limit bucket at will, and
# forge the IP recorded against a submission. Accepts `true`, a hop count, or a
# CIDR / comma-separated IP list. See src/app.ts.
# TRUST_PROXY=true

# App URL — used for approval setup / magic links (Module 1 approval flow)
APP_URL=http://localhost:3000

# OpenSanctions hosted API key (Module 1 sanctions/PEP screening).
# Optional: without it, screening degrades to a pending "screen manually" check
# and never blocks submission.
OPENSANCTIONS_API_KEY=
